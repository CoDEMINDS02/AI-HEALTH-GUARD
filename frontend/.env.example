# Base URL for API requests from the React/Vite frontend.
#
# Production (Railway backend): set this in the Vercel dashboard to your Railway
# backend URL including the /api path. Do NOT add a trailing slash.
# Example:
# VITE_API_BASE_URL=https://your-project.up.railway.app/api
#
# Local development: the Vite dev server proxies /api to the local backend.
VITE_API_BASE_URL=/api
