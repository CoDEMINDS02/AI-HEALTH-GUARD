# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=AI HealthGuard API
ENVIRONMENT=production
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────────────────────
# Production: Supabase PostgreSQL via psycopg3 (SQLAlchemy 2.0).
# Use the Transaction Pooler on port 6543 for Vercel Serverless Functions.
# Replace USER, PASSWORD, HOST with values from Supabase Settings → Database.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres

# Local development fallback (SQLite — no extra driver needed):
# DATABASE_URL=sqlite:///./healthguard.db

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Use "demo" for local development without any API credentials.
# Use "qwen" for Alibaba Cloud DashScope (recommended for hackathon).
# Other options: "openai", "openai-compatible"
AI_PROVIDER=demo

# Required when AI_PROVIDER is "qwen", "openai", or "openai-compatible".
# Leave blank when using AI_PROVIDER=demo.
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus

AI_TIMEOUT_SECONDS=45
AI_MAX_FOLLOW_UP_QUESTIONS=4

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Add your Vercel production URL.
# Replace https://YOUR-VERCEL-DOMAIN.vercel.app with the actual domain.
CORS_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# ─── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=10485760
