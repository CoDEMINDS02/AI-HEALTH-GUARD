# AI provider selection.
# Use "demo" for local development without any API credentials.
# Use "qwen" for Alibaba Cloud DashScope (recommended for hackathon).
# Other options: "openai", "openai-compatible"
AI_PROVIDER=demo

# Required when AI_PROVIDER is "qwen", "openai", or "openai-compatible".
# Leave blank when using AI_PROVIDER=demo.
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus

AI_TIMEOUT_SECONDS=45
AI_MAX_FOLLOW_UP_QUESTIONS=4

# SQLite database path (relative to backend directory).
DATABASE_URL=sqlite:///./healthguard.db

# Comma-separated allowed CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum upload size in bytes (default: 10 MB).
UPLOAD_MAX_BYTES=10485760

LOG_LEVEL=INFO
ENVIRONMENT=development
